#--------------------------------------------------------------------
# Copy this file to `.env` and adjust values for your machine:
#   copy .env.example .env
#--------------------------------------------------------------------

CI_ENVIRONMENT = development

app.baseURL = 'http://localhost/VapeShopSystem/'
app.forceGlobalSecureRequests = false

database.default.hostname = localhost
database.default.database = vapeshop_db
database.default.username = root
database.default.password =
database.default.DBDriver = MySQLi
database.default.port = 3306

# Use the same key as app/Config/Encryption.php or generate a new one.
encryption.key = hex2bin:44dc4f19b6c465dbc14eaf205742328541b0e6f2c3940d76583869a65ccc02ae

session.driver = 'CodeIgniter\Session\Handlers\FileHandler'

logger.threshold = 4

# Max meters between rider GPS and customer delivery pin when submitting proof (default 2000).
DELIVERY_COMPLETION_MAX_DISTANCE_METERS = 2000
