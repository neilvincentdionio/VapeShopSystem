<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F4F6"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/rider_list_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="My Deliveries"
        android:textColor="#111827"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/rider_list_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Assigned delivery orders"
        android:textColor="#6B7280"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/rider_list_search"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_checkout_input"
        android:hint="Search order, customer, address..."
        android:inputType="text"
        android:paddingHorizontal="12dp"
        android:textColor="#111827"
        android:textColorHint="#6B7280"
        android:textSize="14sp" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/rider_list_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
