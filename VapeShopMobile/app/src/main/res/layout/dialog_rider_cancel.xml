<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="The customer cancelled or refused the order in person at delivery."
        android:textColor="#6B7280"
        android:textSize="13sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Notes (optional)"
        android:textColor="#111827"
        android:textSize="13sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/rider_cancel_notes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_checkout_input"
        android:gravity="top|start"
        android:hint="Customer cancelled at delivery location."
        android:inputType="textMultiLine|textCapSentences"
        android:minLines="2"
        android:padding="10dp"
        android:textSize="14sp" />
</LinearLayout>
