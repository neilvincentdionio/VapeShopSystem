<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FFFFFF"
    android:orientation="vertical"
    android:padding="18dp">

    <TextView
        android:id="@+id/dialog_product_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Product Name"
        android:textColor="#111827"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/dialog_product_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Choose puff and flavor before adding to cart."
        android:textColor="#6B7280"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/dialog_puff_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Select Puff"
        android:textColor="#111827"
        android:textSize="14sp"
        android:textStyle="bold" />

    <Spinner
        android:id="@+id/dialog_puff_spinner"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:background="@android:drawable/btn_dropdown"
        android:paddingHorizontal="10dp"
        android:spinnerMode="dropdown" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Select Flavor"
        android:textColor="#111827"
        android:textSize="14sp"
        android:textStyle="bold" />

    <Spinner
        android:id="@+id/dialog_flavor_spinner"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:background="@android:drawable/btn_dropdown"
        android:paddingHorizontal="10dp"
        android:spinnerMode="dropdown" />

    <TextView
        android:id="@+id/dialog_flavor_stock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="#166534"
        android:textSize="12sp" />

</LinearLayout>
