<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="8dp">

    <TextView
        android:id="@+id/refund_order_reference"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Order: RCPT-000000"
        android:textColor="#4B5563"
        android:textSize="11sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Request type: Return &amp; Refund"
        android:textColor="#4B5563"
        android:textSize="11sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Reason"
        android:textColor="#111827"
        android:textSize="12sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/refund_reason_input"
        android:layout_width="match_parent"
        android:layout_height="84dp"
        android:layout_marginTop="6dp"
        android:background="@android:drawable/edit_text"
        android:gravity="top|start"
        android:hint="Reason (minimum 10 characters)"
        android:inputType="textMultiLine"
        android:padding="10dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Photo / Video evidence"
        android:textColor="#111827"
        android:textSize="12sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/refund_choose_files"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:backgroundTint="#E5E7EB"
            android:minWidth="0dp"
            android:paddingHorizontal="12dp"
            android:text="Choose Files"
            android:textAllCaps="false"
            android:textColor="#111827"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/refund_files_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="No file chosen"
            android:textColor="#6B7280"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Upload 1-3 files (image max 5MB, video max 25MB). Show the product defect or issue."
        android:textColor="#6B7280"
        android:textSize="10sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Refund will be sent to this GCash or Maya account after pickup."
        android:textColor="#6B7280"
        android:textSize="10sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Refund Method"
        android:textColor="#111827"
        android:textSize="12sp"
        android:textStyle="bold" />

    <Spinner
        android:id="@+id/refund_method_spinner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="GCash / Maya number"
        android:textColor="#111827"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/refund_account_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@android:drawable/edit_text"
        android:hint="e.g. 09171234567"
        android:inputType="phone"
        android:padding="10dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Account name"
        android:textColor="#111827"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/refund_account_name_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@android:drawable/edit_text"
        android:hint="Name registered to the account"
        android:inputType="text"
        android:padding="10dp" />
</LinearLayout>
