<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FFFFFF"
    android:fillViewport="true"
    android:scrollbars="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Request Return/Refund"
            android:textColor="#111827"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Tell us what went wrong and where to send your refund."
            android:textColor="#6B7280"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_refund_order_summary"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ORDER"
                android:textColor="#065F46"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/refund_order_reference"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="ORD-000000"
                android:textColor="#111827"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/refund_request_type_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Request type: Return &amp; Refund"
                android:textColor="#047857"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="REQUEST TYPE"
            android:textColor="#94A3B8"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="What kind of request is this?"
            android:textColor="#111827"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/refund_request_type_spinner"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_checkout_input"
            android:paddingHorizontal="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="RETURN DETAILS"
            android:textColor="#94A3B8"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Reason"
            android:textColor="#111827"
            android:textSize="13sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/refund_reason_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_checkout_input"
            android:gravity="top|start"
            android:hint="Describe the issue (minimum 10 characters)"
            android:inputType="textMultiLine|textCapSentences"
            android:minLines="3"
            android:maxLines="5"
            android:padding="12dp"
            android:textColor="#111827"
            android:textColorHint="#9CA3AF"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="EVIDENCE"
            android:textColor="#94A3B8"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Photo / Video evidence"
            android:textColor="#111827"
            android:textSize="13sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_checkout_input"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="10dp">

            <Button
                android:id="@+id/refund_choose_files"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/bg_refund_choose_files_btn"
                android:minWidth="0dp"
                android:paddingHorizontal="14dp"
                android:text="Choose Files"
                android:textAllCaps="false"
                android:textColor="#0F766E"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/refund_files_status"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="No file chosen"
                android:textColor="#4B5563"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="2dp"
            android:text="Upload 1–3 files (image max 5MB, video max 25MB). Show the product defect or issue."
            android:textColor="#6B7280"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="REFUND PAYOUT"
            android:textColor="#94A3B8"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:lineSpacingExtra="2dp"
            android:text="Refund will be sent to this GCash or Maya account after pickup."
            android:textColor="#6B7280"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Refund Method"
            android:textColor="#111827"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/refund_method_spinner"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_checkout_input"
            android:paddingHorizontal="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="GCash / Maya number"
            android:textColor="#111827"
            android:textSize="13sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/refund_account_input"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_checkout_input"
            android:hint="e.g. 09171234567"
            android:inputType="phone"
            android:paddingHorizontal="12dp"
            android:textColor="#111827"
            android:textColorHint="#9CA3AF"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Account name"
            android:textColor="#111827"
            android:textSize="13sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/refund_account_name_input"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_checkout_input"
            android:hint="Name registered to the account"
            android:inputType="textPersonName|textCapWords"
            android:paddingHorizontal="12dp"
            android:textColor="#111827"
            android:textColorHint="#9CA3AF"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/refund_btn_cancel"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_refund_cancel_btn"
                android:text="Cancel"
                android:textAllCaps="false"
                android:textColor="#374151"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/refund_btn_submit"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/bg_refund_submit_btn"
                android:text="Submit Request"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
