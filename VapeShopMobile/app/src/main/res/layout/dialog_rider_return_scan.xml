<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ask the customer to show the return QR from their order. You can scan it or paste the code manually."
        android:textColor="#6B7280"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/rider_return_open_scanner"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_rider_scan_btn"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:text="Open QR Scanner"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="Or paste return QR code"
        android:textColor="#111827"
        android:textSize="13sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/rider_return_qr_manual"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_checkout_input"
        android:hint="Paste QR text or token..."
        android:inputType="text"
        android:padding="10dp"
        android:textSize="14sp" />
</LinearLayout>
