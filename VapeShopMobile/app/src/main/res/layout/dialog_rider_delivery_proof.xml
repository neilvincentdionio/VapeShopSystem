<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Take a photo as proof that the order was delivered."
        android:textColor="#6B7280"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/rider_proof_choose_photo"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_rider_detail_btn"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:text="Take Photo"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/rider_proof_file_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="No photo taken yet"
        android:textColor="#6B7280"
        android:textSize="12sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Delivery notes (optional)"
        android:textColor="#111827"
        android:textSize="13sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/rider_proof_notes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_checkout_input"
        android:gravity="top|start"
        android:hint="Add any notes about the delivery..."
        android:inputType="textMultiLine|textCapSentences"
        android:minLines="2"
        android:padding="10dp"
        android:textSize="14sp" />
</LinearLayout>
