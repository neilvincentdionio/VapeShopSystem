<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Widget.VapeShop.ActionButton" parent="Widget.AppCompat.Button">
        <item name="android:minHeight">36dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">12sp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:backgroundTint">@null</item>
        <item name="backgroundTint">@null</item>
    </style>

    <style name="Widget.VapeShop.ActionButton.Primary" parent="Widget.VapeShop.ActionButton">
        <item name="android:background">@drawable/bg_purchase_action_primary</item>
        <item name="android:textColor">#FFFFFF</item>
    </style>

    <style name="Widget.VapeShop.ActionButton.Outline" parent="Widget.VapeShop.ActionButton">
        <item name="android:background">@drawable/bg_purchase_action_outline</item>
        <item name="android:textColor">#166534</item>
    </style>

    <style name="Widget.VapeShop.ActionButton.Secondary" parent="Widget.VapeShop.ActionButton">
        <item name="android:background">@drawable/bg_purchase_action_secondary</item>
        <item name="android:textColor">#374151</item>
    </style>

    <style name="Widget.VapeShop.ActionButton.Muted" parent="Widget.VapeShop.ActionButton">
        <item name="android:background">@drawable/bg_purchase_action_muted</item>
        <item name="android:textColor">#6B7280</item>
    </style>
</resources>
